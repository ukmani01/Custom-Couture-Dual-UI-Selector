<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>MORPHEUS — The Behavioral Commerce Engine</title>
  <!-- SYSTEM_ID: LUX_005 | DESIGN_LANGUAGE: AI Morphic Layout System (Conversion-First Emotional UX) -->
  <style>
    /* ---------- PREMIUM DESIGN SYSTEM (₹40,000 VALUE) ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --ink-black: #0F0E0D;
      --paper-white: #FDFBF7;
      --accent-amber: #C89F5E;
      --accent-deep: #9B7640;
      --stone-light: #E8E2D5;
      --text-muted: #5A544C;
      --error-red: #C86F5E;
      --success-green: #5C7A5B;
      --shadow-soft: 0 12px 28px -8px rgba(0,0,0,0.05), 0 1px 2px rgba(0,0,0,0.02);
      --shadow-hover: 0 25px 35px -12px rgba(0,0,0,0.1);
      --transition-core: all 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

    body {
      background: var(--paper-white);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: var(--ink-black);
      line-height: 1.4;
      overflow-x: hidden;
    }

    .serif {
      font-family: 'Cormorant Garamond', serif;
    }

    /* premium scroll */
    ::-webkit-scrollbar {
      width: 4px;
      background: #EAE4DA;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--accent-amber);
      border-radius: 4px;
    }

    /* container system */
    .ux-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* attention-grabbing hero animation (psychological impact) */
    @keyframes cognitiveReveal {
      0% { opacity: 0; transform: translateY(36px) scale(0.98); filter: blur(4px); }
      100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }
    .hero-cognitive {
      animation: cognitiveReveal 1.1s cubic-bezier(0.12, 0.71, 0.33, 1) forwards;
    }

    /* product card – behavioral hover (dopamine feedback) */
    .product-behavior {
      background: white;
      transition: var(--transition-core);
      border-radius: 0px;
      overflow: hidden;
      cursor: pointer;
    }
    .product-behavior:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
    }
    .image-shift {
      transition: transform 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
    }
    .product-behavior:hover .image-shift {
      transform: scale(1.03);
    }

    /* quick action overlay (progressive disclosure) */
    .action-rail {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(0deg, rgba(15,14,13,0.9) 0%, rgba(0,0,0,0) 100%);
      padding: 1.2rem 1rem 0.8rem;
      transform: translateY(100%);
      transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    .product-behavior:hover .action-rail {
      transform: translateY(0);
    }

    /* category pills – cognitive ease */
    .pill-ux {
      background: transparent;
      border: 1px solid #DCD3C8;
      padding: 0.5rem 1.4rem;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: all 0.2s;
      cursor: pointer;
      color: var(--text-muted);
    }
    .pill-ux.active {
      background: var(--ink-black);
      border-color: var(--ink-black);
      color: white;
    }
    .pill-ux:hover {
      border-color: var(--accent-amber);
    }

    /* conversion CTA primary */
    .btn-conversion {
      background: var(--ink-black);
      color: white;
      padding: 0.9rem 2.2rem;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      transition: background 0.3s, transform 0.2s;
      border: none;
      cursor: pointer;
    }
    .btn-conversion:hover {
      background: var(--accent-deep);
      transform: translateY(-2px);
    }

    /* scarcity + trust ribbon */
    .trust-ribbon {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
      flex-wrap: wrap;
      border-top: 1px solid #E3DBCF;
      border-bottom: 1px solid #E3DBCF;
      padding: 2rem 0;
      margin: 3rem 0;
    }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* tailwind override for premium spacing */
    .custom-container { max-width: 1440px; margin: 0 auto; padding: 0 2rem; }
    @media (max-width: 640px) { .custom-container { padding: 0 1.2rem; } }
  </style>
</head>
<body>

  <!-- ========== ATTENTION CAPTURE: EMOTIONAL HERO ========== -->
  <header class="fixed top-0 left-0 w-full z-50 bg-white/85 backdrop-blur-sm border-b border-[#EDE6DD]">
    <div class="custom-container py-5 flex flex-wrap items-center justify-between gap-4">
      <div class="serif text-2xl tracking-[0.2em] font-light">MORPHEUS</div>
      <div class="hidden md:flex gap-6 text-[0.65rem] uppercase tracking-wider font-medium">
        <button data-cat="all" class="pill-ux active">All Objects</button>
        <button data-cat="watches" class="pill-ux">Horology</button>
        <button data-cat="apparel" class="pill-ux">Garments</button>
        <button data-cat="accessories" class="pill-ux">Objets</button>
        <button data-cat="footwear" class="pill-ux">Chaussures</button>
        <button data-cat="jewelry" class="pill-ux">Bijoux</button>
      </div>
      <div class="flex items-center gap-6">
        <div class="relative">
          <input type="text" id="behaviorSearch" placeholder="Search" class="pl-3 pr-7 py-2 border-b border-[#DCD3C8] bg-transparent text-sm focus:outline-none focus:border-[#C89F5E] transition">
          <span class="absolute right-1 top-2 text-gray-400 text-sm">🔍</span>
        </div>
        <button id="cartBehaviorBtn" class="relative text-lg">🛒 <span id="cartBehaviorCount" class="absolute -top-2 -right-3 w-5 h-5 bg-[#9B7640] text-white text-[10px] rounded-full flex items-center justify-center">0</span></button>
        <button id="wishBehaviorBtn" class="text-lg">♡</button>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION: EMOTIONAL + PSYCHOLOGICAL TRIGGER (ATTENTION + INTEREST) -->
    <section class="custom-container pt-36 pb-16">
      <div class="hero-cognitive grid md:grid-cols-2 gap-12 items-end">
        <div>
          <div class="inline-block px-3 py-1 bg-[#E8E2D5] text-[0.6rem] uppercase tracking-[0.2em] mb-4">Archetype 01</div>
          <h1 class="serif text-6xl md:text-7xl font-light leading-[1.08] tracking-tight">The<br>Visible <span class="italic text-[#C89F5E]">Quiet</span></h1>
          <p class="mt-5 text-[#5A544C] max-w-md text-base leading-relaxed">Material poetry for the discerning. Each piece engineered for longevity — not seasons.</p>
          <div class="flex gap-4 mt-8">
            <button id="heroCtaBehavior" class="btn-conversion">Explore collection →</button>
            <button id="storyCtaBehavior" class="border border-[#DCD3C8] px-6 py-3 text-xs uppercase tracking-wide hover:bg-white transition">Our manifesto</button>
          </div>
          <!-- scarcity anchor (cognitive bias) -->
          <div class="flex gap-6 mt-8 text-xs text-[#6C6258]">
            <span>✦ 12 limited editions</span>
            <span>✦ 4.9 ★ global reputation</span>
            <span>✦ Free worldwide delivery</span>
          </div>
        </div>
        <div class="text-right">
          <div class="serif text-8xl text-[#C89F5E]/20">⎔</div>
          <p class="text-sm italic text-[#8A7E6E] mt-4">"Behavioral luxury" — Wallpaper*</p>
        </div>
      </div>
    </section>

    <!-- TRUST + SOCIAL PROOF LAYER -->
    <div class="custom-container trust-ribbon">
      <div class="text-center"><span class="font-semibold">4.92 ★</span> <span class="text-xs text-[#6B6258]">Global rating (2.1k reviews)</span></div>
      <div class="text-center"><span class="font-semibold">Carbon neutral</span> <span class="text-xs text-[#6B6258]">certified</span></div>
      <div class="text-center"><span class="font-semibold">Lifetime care</span> <span class="text-xs text-[#6B6258]">included</span></div>
      <div class="text-center"><span class="font-semibold">98% repurchase</span> <span class="text-xs text-[#6B6258]">loyalty rate</span></div>
    </div>

    <!-- PRODUCT DISCOVERY SYSTEM (featured collection) -->
    <section class="custom-container py-12">
      <div class="flex justify-between items-end mb-10 flex-wrap gap-4">
        <div>
          <p class="text-xs tracking-[0.2em] text-[#9B7640] uppercase">Current objects</p>
          <h2 class="serif text-4xl font-light">The <span class="italic">Edit</span></h2>
        </div>
        <div class="text-[0.65rem] text-[#6B6258] bg-white/60 px-4 py-2 border border-[#E8E2D5]">👉 Only 3–8 units per piece</div>
      </div>
      <div id="behaviorProductGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-7"></div>
    </section>

    <!-- BRAND STORY + EMOTIONAL NARRATIVE (DESIRE BUILDING) -->
    <section class="custom-container my-16">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <img src="https://images.unsplash.com/photo-1523381294911-8d3cead13475?w=800&q=80" alt="Craftsmanship" class="w-full aspect-[4/3] object-cover grayscale-[0.2]">
        </div>
        <div>
          <p class="text-xs tracking-[0.3em] text-[#9B7640] uppercase">Philosophy</p>
          <h3 class="serif text-4xl font-light mt-2">Slowness as <span class="italic">virtue</span></h3>
          <p class="mt-4 text-[#5A544C] leading-relaxed">Morpheus was born from the rejection of mass production. Each object is hand‑finished by artisans in Tuscany and Kyoto — a dialogue between materials and patience.</p>
          <div class="mt-6 flex gap-3">
            <div class="w-12 h-[2px] bg-[#C89F5E]"></div>
            <div class="w-6 h-[2px] bg-[#DCD3C8]"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONVERSION CTA ENGINE (SCARCITY + URGENCY) -->
    <section class="custom-container my-20">
      <div class="bg-[#0F0E0D] text-white p-12 text-center">
        <p class="text-[0.6rem] tracking-[0.3em] uppercase text-[#C89F5E]">Final archive window</p>
        <h4 class="serif text-4xl md:text-5xl font-light mt-2">The Reserve Collection</h4>
        <p class="mt-3 max-w-md mx-auto text-[#CAC3BC] text-sm">Last opportunity to acquire limited pieces. Once archived, they will not return.</p>
        <button id="reserveCtaBehavior" class="mt-7 bg-white text-black px-8 py-3 text-xs uppercase tracking-wider hover:bg-[#C89F5E] hover:text-white transition">Secure a piece →</button>
      </div>
    </section>

    <!-- NEWSLETTER + TRUST CAPTURE (value exchange) -->
    <section class="custom-container pb-24">
      <div class="bg-[#F2EFEA] p-10 text-center">
        <h5 class="serif text-2xl font-light">The Morpheus Chronicle</h5>
        <p class="text-sm text-[#5E5549] mt-2">Private viewings, early access & material insights.</p>
        <form id="behaviorNewsForm" class="max-w-md mx-auto mt-6 flex flex-col sm:flex-row gap-3">
          <input type="email" id="behaviorNewsEmail" placeholder="Your email address" class="flex-1 px-5 py-3 border-0 focus:ring-1 focus:ring-[#C89F5E] outline-none" required>
          <button type="submit" class="bg-[#0F0E0D] text-white px-6 py-3 text-xs uppercase tracking-wider hover:bg-[#9B7640] transition">Subscribe</button>
        </form>
        <div id="behaviorNewsMsg" class="text-sm mt-3 text-[#9B7640]"></div>
      </div>
    </section>
  </main>

  <footer class="border-t border-[#EBE4DB] py-8 text-center text-xs text-[#6B6258]">
    <p>© MORPHEUS — Behaviorally designed commerce. All objects are made to outlive.</p>
  </footer>

  <!-- CART DRAWER (frictionless) -->
  <div id="behaviorCartDrawer" class="fixed top-0 right-0 h-full w-96 bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-500 p-6 overflow-auto">
    <div class="flex justify-between border-b pb-4"><h2 class="serif text-xl font-light">Your selection</h2><button id="closeBehaviorCart">✕</button></div>
    <div id="behaviorCartItems" class="py-4 space-y-4"></div>
    <div class="border-t pt-4 mt-4"><div class="flex justify-between font-medium"><span>Total</span><span id="behaviorCartTotal">$0</span></div><button id="behaviorCheckoutBtn" class="w-full mt-4 bg-black text-white py-3 text-xs uppercase tracking-wider">Secure checkout →</button></div>
  </div>
  <div id="behaviorCartOverlay" class="fixed inset-0 bg-black/30 z-40 hidden"></div>

  <!-- WISHLIST DRAWER -->
  <div id="behaviorWishDrawer" class="fixed top-0 left-0 h-full w-80 bg-[#0F0E0D] text-white z-50 transform -translate-x-full transition-transform duration-500 p-6">
    <div class="flex justify-between border-b border-white/20 pb-4"><h2 class="serif text-xl font-light">Wishlist</h2><button id="closeBehaviorWish">✕</button></div>
    <div id="behaviorWishItems" class="mt-4 space-y-4"></div>
  </div>

  <script>
    // ============================================================
    // ₹40,000 BEHAVIORAL ECOMMERCE ENGINE
    // Cart: reducerActionDispatch pattern | Wishlist: classSetMethods + localStorage
    // Search: immediateThenDelay with micro-feedback
    // Psychology: scarcity cues, trust anchoring, cognitive ease
    // ============================================================
    (function() {
      // products (high-value objects, scarcity embedded)
      const inventory = [
        { id: 'b1', name: 'Aether Chronograph', price: 4850, category: 'watches', material: 'Titanium / Sapphire', img: 'https://picsum.photos/id/20/500/600', scarcity: 'Only 3 left', badge: 'Limited' },
        { id: 'b2', name: 'Noir Kimono Coat', price: 1250, category: 'apparel', material: 'Handwoven Silk', img: 'https://picsum.photos/id/30/500/600', scarcity: 'Last unit', badge: 'Archive' },
        { id: 'b3', name: 'Monolith Leather Tote', price: 890, category: 'accessories', material: 'Tuscan Leather', img: 'https://picsum.photos/id/40/500/600', scarcity: 'Made to order', badge: null },
        { id: 'b4', name: 'Obsidian Frame', price: 450, category: 'accessories', material: 'Polarized CR39', img: 'https://picsum.photos/id/42/500/600', scarcity: 'Low stock', badge: 'Eco' },
        { id: 'b5', name: 'Echelon Loafers', price: 720, category: 'footwear', material: 'Calfskin', img: 'https://picsum.photos/id/43/500/600', scarcity: 'Limited sizes', badge: 'New' },
        { id: 'b6', name: 'Halo Diamond Cuff', price: 3200, category: 'jewelry', material: '18k Gold', img: 'https://picsum.photos/id/34/500/600', scarcity: '1 remaining', badge: 'Icon' },
        { id: 'b7', name: 'Cashmere Zen', price: 980, category: 'apparel', material: 'Mongolian Cashmere', img: 'https://picsum.photos/id/26/500/600', scarcity: 'Pre-order', badge: null },
        { id: 'b8', name: 'Void Sonic', price: 1550, category: 'electronics', material: 'Aluminum', img: 'https://picsum.photos/id/0/500/600', scarcity: 'Signature run', badge: 'Signature' }
      ];
      
      let activeCat = 'all';
      let searchPhrase = '';
      
      // ---------- CART: reducer pattern (action dispatch, clean state)
      let cartState = { items: [] };
      const cartReducer = (state, action) => {
        switch (action.type) {
          case 'ADD': {
            const existing = state.items.find(i => i.id === action.id);
            if (existing) existing.qty++;
            else state.items.push({ id: action.id, name: action.name, price: action.price, qty: 1, img: action.img });
            break;
          }
          case 'REMOVE': state.items = state.items.filter(i => i.id !== action.id); break;
          case 'UPDATE_QTY': { const item = state.items.find(i => i.id === action.id); if (item) item.qty = action.qty; break; }
        }
        localStorage.setItem('behavior_cart', JSON.stringify(state.items));
        return state;
      };
      
      const saved = localStorage.getItem('behavior_cart');
      if (saved) cartState.items = JSON.parse(saved);
      
      function dispatchCart(action) { cartReducer(cartState, action); renderCartUI(); }
      
      function renderCartUI() {
        let total = 0, count = 0;
        cartState.items.forEach(i => { total += i.price * i.qty; count += i.qty; });
        document.getElementById('cartBehaviorCount').innerText = count;
        document.getElementById('behaviorCartTotal').innerText = '$' + total.toLocaleString();
        const container = document.getElementById('behaviorCartItems');
        if (cartState.items.length === 0) { container.innerHTML = '<div class="text-center text-gray-500 py-8">No pieces selected</div>'; return; }
        container.innerHTML = cartState.items.map(i => `
          <div class="flex justify-between items-center border-b pb-3">
            <div><span class="font-medium">${i.name}</span> x${i.qty}</div>
            <div>$${(i.price * i.qty).toLocaleString()}</div>
            <button onclick="removeFromBehaviorCart('${i.id}')" class="text-[#9B7640] text-sm">✕</button>
          </div>
        `).join('');
      }
      
      window.removeFromBehaviorCart = (id) => { dispatchCart({ type: 'REMOVE', id }); };
      function addToBehaviorCart(id) {
        const prod = inventory.find(p => p.id === id);
        if (prod) dispatchCart({ type: 'ADD', id: prod.id, name: prod.name, price: prod.price, img: prod.img });
        showBehaviorToast(`Added: ${prod.name}`, 'emerald');
      }
      window.addToBehaviorCart = addToBehaviorCart;
      
      // ---------- WISHLIST: classSet approach (localStorage)
      let wishSet = new Set(JSON.parse(localStorage.getItem('behavior_wishlist') || '[]'));
      
      function toggleBehaviorWish(id) {
        if (wishSet.has(id)) wishSet.delete(id);
        else wishSet.add(id);
        localStorage.setItem('behavior_wishlist', JSON.stringify(Array.from(wishSet)));
        renderProducts();
        renderWishUI();
        showBehaviorToast(wishSet.has(id) ? 'Saved to wishlist' : 'Removed', 'rose');
      }
      
      function renderWishUI() {
        const container = document.getElementById('behaviorWishItems');
        const wishIds = Array.from(wishSet);
        const items = inventory.filter(p => wishIds.includes(p.id));
        if (items.length === 0) { container.innerHTML = '<div class="text-gray-400 text-center">No saved objects</div>'; return; }
        container.innerHTML = items.map(p => `
          <div class="flex gap-3 border-b border-white/20 pb-3">
            <img src="${p.img}" class="w-16 h-20 object-cover">
            <div><div class="font-medium">${p.name}</div><div>$${p.price}</div><button onclick="toggleBehaviorWish('${p.id}')" class="text-[#C89F5E] text-xs mt-1">Remove</button></div>
          </div>
        `).join('');
      }
      
      // ---------- PRODUCT GRID RENDER (behavioral layout)
      function renderProducts() {
        let filtered = inventory.filter(p => activeCat === 'all' || p.category === activeCat);
        if (searchPhrase.trim() !== '') {
          filtered = filtered.filter(p => p.name.toLowerCase().includes(searchPhrase.toLowerCase()) || p.material.toLowerCase().includes(searchPhrase.toLowerCase()));
        }
        const grid = document.getElementById('behaviorProductGrid');
        grid.innerHTML = filtered.map(p => {
          const inWish = wishSet.has(p.id);
          return `
            <div class="product-behavior group bg-white border border-[#EDE6DD]">
              <div class="relative overflow-hidden">
                <img src="${p.img}" class="image-shift" alt="${p.name}">
                ${p.scarcity ? `<div class="absolute top-3 left-3 bg-[#9B7640] text-white text-[0.6rem] px-2 py-0.5 uppercase tracking-wide z-10">${p.scarcity}</div>` : ''}
                <button onclick="toggleBehaviorWish('${p.id}')" class="absolute top-3 right-3 w-8 h-8 bg-white/90 rounded-full flex items-center justify-center text-base shadow-sm hover:scale-105 transition">${inWish ? '❤️' : '♡'}</button>
                <div class="action-rail">
                  <button onclick="addToBehaviorCart('${p.id}')" class="w-full bg-white text-black py-2 text-[0.65rem] uppercase tracking-wider font-medium transition hover:bg-[#C89F5E] hover:text-white">Add to cart</button>
                </div>
              </div>
              <div class="p-5">
                <div class="text-[0.6rem] uppercase tracking-wider text-[#9B7640]">${p.material}</div>
                <div class="serif text-xl font-light mt-1">${p.name}</div>
                <div class="flex justify-between items-center mt-2">
                  <span class="text-base font-medium">$${p.price.toLocaleString()}</span>
                  ${p.badge ? `<span class="text-[9px] border border-[#C89F5E] px-2 py-0.5 text-[#9B7640]">${p.badge}</span>` : ''}
                </div>
              </div>
            </div>
          `;
        }).join('');
      }
      
      function setBehaviorCategory(cat, btn) {
        activeCat = cat;
        document.querySelectorAll('.pill-ux').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderProducts();
      }
      
      // ---------- SEARCH (cognitive ease: immediate feedback)
      let searchTimer;
      const searchInput = document.getElementById('behaviorSearch');
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          searchPhrase = e.target.value;
          renderProducts();
        }, 100);
      });
      
      // ---------- NEWSLETTER (value exchange, no spam)
      document.getElementById('behaviorNewsForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.getElementById('behaviorNewsEmail').value;
        if (email && email.includes('@')) {
          let subs = JSON.parse(localStorage.getItem('behavior_newsletter') || '[]');
          if (!subs.includes(email)) subs.push(email);
          localStorage.setItem('behavior_newsletter', JSON.stringify(subs));
          document.getElementById('behaviorNewsMsg').innerHTML = '✓ Confirmed. You will receive the next chronicle.';
          document.getElementById('behaviorNewsEmail').value = '';
        } else alert('Valid email required');
      });
      
      // micro-feedback toast (dopamine)
      function showBehaviorToast(msg, type = 'default') {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-[#0F0E0D] text-white px-6 py-3 rounded-full text-sm z-[9999] shadow-xl transition-all duration-300`;
        toast.innerText = msg;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2200);
      }
      
      // UI event bindings
      document.querySelectorAll('.pill-ux').forEach(btn => {
        btn.addEventListener('click', () => setBehaviorCategory(btn.getAttribute('data-cat'), btn));
      });
      document.getElementById('cartBehaviorBtn').onclick = () => { document.getElementById('behaviorCartDrawer').classList.remove('translate-x-full'); document.getElementById('behaviorCartOverlay').classList.remove('hidden'); };
      document.getElementById('closeBehaviorCart').onclick = () => { document.getElementById('behaviorCartDrawer').classList.add('translate-x-full'); document.getElementById('behaviorCartOverlay').classList.add('hidden'); };
      document.getElementById('behaviorCartOverlay').onclick = () => { document.getElementById('behaviorCartDrawer').classList.add('translate-x-full'); document.getElementById('behaviorCartOverlay').classList.add('hidden'); };
      document.getElementById('wishBehaviorBtn').onclick = () => { document.getElementById('behaviorWishDrawer').classList.remove('-translate-x-full'); };
      document.getElementById('closeBehaviorWish').onclick = () => { document.getElementById('behaviorWishDrawer').classList.add('-translate-x-full'); };
      document.getElementById('heroCtaBehavior').onclick = () => document.getElementById('behaviorProductGrid').scrollIntoView({ behavior: 'smooth' });
      document.getElementById('storyCtaBehavior').onclick = () => alert('Morpheus: where material integrity and behavioral design converge.');
      document.getElementById('reserveCtaBehavior').onclick = () => { document.getElementById('behaviorProductGrid').scrollIntoView({ behavior: 'smooth' }); showBehaviorToast('Limited pieces reserve now', 'gold'); };
      document.getElementById('behaviorCheckoutBtn').onclick = () => alert('Checkout — behavioral commerce at its finest.');
      
      // initial renders
      renderProducts();
      renderCartUI();
      renderWishUI();
    })();
  </script>
