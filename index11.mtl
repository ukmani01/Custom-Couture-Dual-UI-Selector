<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GlobalPath - Study Abroad Consultancy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        /* ==========================================================================
           1. CSS Variables & Reset
           ========================================================================== */
        :root {
            --primary-dark: #0b1c3d;
            --primary-blue: #102a4d;
            --accent-blue: #1d4ed8;
            --accent-blue-hover: #1e40af;
            --orange-accent: #f59e0b;
            --bg-light: #f8fafc;
            --bg-white: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --text-light: #94a3b8;
            --border-light: #e2e8f0;
            --font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --radius-md: 8px;
            --radius-lg: 12px;
            --radius-xl: 16px;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ==========================================================================
           2. Reset & Base
           ========================================================================== */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-family);
            color: var(--text-dark);
            background-color: var(--bg-white);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }
        ul {
            list-style: none;
        }
        img {
            max-width: 100%;
            display: block;
            object-fit: cover;
        }

        /* ==========================================================================
           3. Tailwind-style Utilities
           ========================================================================== */
        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* Flex */
        .flex {
            display: flex;
        }
        .flex-col {
            flex-direction: column;
        }
        .flex-wrap {
            flex-wrap: wrap;
        }
        .items-center {
            align-items: center;
        }
        .items-start {
            align-items: flex-start;
        }
        .items-end {
            align-items: flex-end;
        }
        .justify-center {
            justify-content: center;
        }
        .justify-between {
            justify-content: space-between;
        }
        .justify-end {
            justify-content: flex-end;
        }
        .gap-1 {
            gap: 0.25rem;
        }
        .gap-2 {
            gap: 0.5rem;
        }
        .gap-3 {
            gap: 0.75rem;
        }
        .gap-4 {
            gap: 1rem;
        }
        .gap-6 {
            gap: 1.5rem;
        }
        .gap-8 {
            gap: 2rem;
        }
        .gap-12 {
            gap: 3rem;
        }

        /* Grid */
        .grid {
            display: grid;
        }
        .grid-cols-1 {
            grid-template-columns: 1fr;
        }
        .grid-cols-2 {
            grid-template-columns: 1fr 1fr;
        }
        .grid-cols-3 {
            grid-template-columns: 1fr 1fr 1fr;
        }
        .grid-cols-4 {
            grid-template-columns: 1fr 1fr 1fr 1fr;
        }
        .grid-cols-5 {
            grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
        }

        /* Spacing */
        .p-1 {
            padding: 0.25rem;
        }
        .p-2 {
            padding: 0.5rem;
        }
        .p-4 {
            padding: 1rem;
        }
        .p-6 {
            padding: 1.5rem;
        }
        .p-8 {
            padding: 2rem;
        }
        .p-12 {
            padding: 3rem;
        }
        .px-2 {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
        .px-4 {
            padding-left: 1rem;
            padding-right: 1rem;
        }
        .px-6 {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }
        .px-8 {
            padding-left: 2rem;
            padding-right: 2rem;
        }
        .py-2 {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }
        .py-4 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        .py-6 {
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
        }
        .py-8 {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }
        .py-12 {
            padding-top: 3rem;
            padding-bottom: 3rem;
        }
        .py-16 {
            padding-top: 4rem;
            padding-bottom: 4rem;
        }

        .m-0 {
            margin: 0;
        }
        .mt-2 {
            margin-top: 0.5rem;
        }
        .mt-4 {
            margin-top: 1rem;
        }
        .mt-6 {
            margin-top: 1.5rem;
        }
        .mt-8 {
            margin-top: 2rem;
        }
        .mt-12 {
            margin-top: 3rem;
        }
        .mb-2 {
            margin-bottom: 0.5rem;
        }
        .mb-4 {
            margin-bottom: 1rem;
        }
        .mb-6 {
            margin-bottom: 1.5rem;
        }
        .mb-8 {
            margin-bottom: 2rem;
        }
        .mb-12 {
            margin-bottom: 3rem;
        }
        .mx-auto {
            margin-left: auto;
            margin-right: auto;
        }

        /* Typography */
        .text-center {
            text-align: center;
        }
        .text-left {
            text-align: left;
        }
        .text-right {
            text-align: right;
        }
        .text-xs {
            font-size: 0.75rem;
        }
        .text-sm {
            font-size: 0.875rem;
        }
        .text-base {
            font-size: 1rem;
        }
        .text-lg {
            font-size: 1.125rem;
        }
        .text-xl {
            font-size: 1.25rem;
        }
        .text-2xl {
            font-size: 1.5rem;
        }
        .text-3xl {
            font-size: 1.875rem;
        }
        .text-4xl {
            font-size: 2.25rem;
        }
        .text-5xl {
            font-size: 3rem;
        }
        .text-6xl {
            font-size: 3.75rem;
        }
        .font-normal {
            font-weight: 400;
        }
        .font-medium {
            font-weight: 500;
        }
        .font-semibold {
            font-weight: 600;
        }
        .font-bold {
            font-weight: 700;
        }
        .font-extrabold {
            font-weight: 800;
        }
        .leading-tight {
            line-height: 1.25;
        }
        .leading-relaxed {
            line-height: 1.625;
        }
        .text-white {
            color: #fff;
        }
        .text-dark {
            color: var(--text-dark);
        }
        .text-muted {
            color: var(--text-muted);
        }
        .text-light {
            color: var(--text-light);
        }
        .text-blue {
            color: var(--accent-blue);
        }
        .text-orange {
            color: var(--orange-accent);
        }

        /* Backgrounds */
        .bg-white {
            background-color: var(--bg-white);
        }
        .bg-light {
            background-color: var(--bg-light);
        }
        .bg-dark {
            background-color: var(--primary-dark);
        }
        .bg-blue {
            background-color: var(--accent-blue);
        }
        .bg-blue-hover:hover {
            background-color: var(--accent-blue-hover);
        }

        /* Borders & Radius */
        .rounded {
            border-radius: var(--radius-md);
        }
        .rounded-lg {
            border-radius: var(--radius-lg);
        }
        .rounded-xl {
            border-radius: var(--radius-xl);
        }
        .rounded-full {
            border-radius: 9999px;
        }
        .border {
            border: 1px solid var(--border-light);
        }
        .border-0 {
            border: 0;
        }
        .shadow-sm {
            box-shadow: var(--shadow-sm);
        }
        .shadow-md {
            box-shadow: var(--shadow-md);
        }
        .shadow-lg {
            box-shadow: var(--shadow-lg);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            border-radius: var(--radius-md);
            transition: var(--transition);
            cursor: pointer;
            border: none;
            font-family: inherit;
            font-size: 0.875rem;
            line-height: 1.25;
            text-align: center;
            white-space: nowrap;
        }
        .btn-primary {
            background-color: var(--accent-blue);
            color: #fff;
        }
        .btn-primary:hover {
            background-color: var(--accent-blue-hover);
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }
        .btn-outline {
            background-color: transparent;
            color: var(--accent-blue);
            border: 2px solid var(--accent-blue);
        }
        .btn-outline:hover {
            background-color: var(--accent-blue);
            color: #fff;
        }
        .btn-dark {
            background-color: var(--primary-dark);
            color: #fff;
        }
        .btn-dark:hover {
            background-color: #1a2d53;
            box-shadow: var(--shadow-md);
        }
        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.75rem;
        }
        .btn-lg {
            padding: 1rem 2rem;
            font-size: 1rem;
        }
        .btn-block {
            width: 100%;
        }
        .btn-ghost {
            background: transparent;
            color: var(--accent-blue);
        }
        .btn-ghost:hover {
            background: rgba(29, 78, 216, 0.05);
        }

        /* Forms */
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            font-family: inherit;
            font-size: 0.875rem;
            transition: var(--transition);
            background: #fff;
            color: var(--text-dark);
        }
        .form-input:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
        }
        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-dark);
            margin-bottom: 0.25rem;
        }
        .form-group {
            margin-bottom: 1rem;
        }
        select.form-input {
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 0.5rem center;
            background-repeat: no-repeat;
            background-size: 1.5em 1.5em;
            padding-right: 2.5rem;
        }

        /* Hide/Show pages */
        .page-section {
            display: none;
            animation: fadeIn 0.5s ease;
        }
        .page-section.active {
            display: block;
        }
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ==========================================================================
           4. Components & Layouts
           ========================================================================== */

        /* Navigation */
        .navbar {
            background: #fff;
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }
        .navbar .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-dark);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .navbar .logo svg {
            width: 32px;
            height: 32px;
            fill: var(--accent-blue);
        }
        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }
        .nav-links a {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
            position: relative;
            cursor: pointer;
        }
        .nav-links a:hover,
        .nav-links a.active {
            color: var(--text-dark);
        }
        .nav-links a.active::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--accent-blue);
        }
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 5px;
        }
        .hamburger span {
            width: 25px;
            height: 3px;
            background: var(--text-dark);
            border-radius: 2px;
            transition: var(--transition);
        }

        /* Hero */
        .hero-section {
            padding: 4rem 0;
        }
        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.1;
            color: var(--text-dark);
            margin-bottom: 1rem;
        }
        .hero-content p {
            color: var(--text-muted);
            font-size: 1.125rem;
            max-width: 540px;
            margin-bottom: 2rem;
        }
        .hero-image img {
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-lg);
            width: 100%;
            height: auto;
            object-fit: cover;
        }

        /* Stats */
        .stats-container {
            background: #fff;
            padding: 2rem 0;
            border-bottom: 1px solid var(--border-light);
        }
        .stat-item {
            text-align: center;
        }
        .stat-item .number {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--text-dark);
        }
        .stat-item .label {
            font-size: 0.875rem;
            color: var(--text-muted);
            font-weight: 500;
        }
        .stat-item .icon {
            margin-bottom: 0.5rem;
            color: var(--accent-blue);
        }

        /* Section Headers */
        .section-header h2 {
            font-size: 2.25rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        .section-header p {
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Logos / Partners */
        .partner-logos {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 2rem 3rem;
            padding: 2rem 0;
        }
        .partner-logo {
            opacity: 0.7;
            filter: grayscale(100%);
            transition: var(--transition);
            height: 40px;
            object-fit: contain;
        }
        .partner-logo:hover {
            opacity: 1;
            filter: grayscale(0%);
        }

        /* Service Cards */
        .service-card {
            background: #fff;
            padding: 2rem 1.5rem;
            border-radius: var(--radius-xl);
            border: 1px solid var(--border-light);
            text-align: center;
            transition: var(--transition);
        }
        .service-card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-4px);
        }
        .service-card .icon-wrapper {
            width: 60px;
            height: 60px;
            margin: 0 auto 1rem;
            background: rgba(29, 78, 216, 0.05);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
        }
        .service-card h3 {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .service-card p {
            font-size: 0.875rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* Journey Steps */
        .journey-step {
            text-align: center;
            padding: 1rem;
            position: relative;
        }
        .journey-step .step-number {
            width: 48px;
            height: 48px;
            background: var(--bg-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.125rem;
            color: var(--accent-blue);
            margin: 0 auto 1rem;
            border: 2px solid var(--border-light);
        }
        .journey-step h4 {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }
        .journey-step p {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        /* Testimonials */
        .testimonial-card {
            background: #fff;
            padding: 2rem;
            border-radius: var(--radius-xl);
            border: 1px solid var(--border-light);
            transition: var(--transition);
        }
        .testimonial-card:hover {
            box-shadow: var(--shadow-md);
        }
        .testimonial-card .stars {
            color: var(--orange-accent);
            margin-bottom: 1rem;
            font-size: 1.25rem;
        }
        .testimonial-card .quote {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        .testimonial-card .author {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .testimonial-card .author img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
        }
        .testimonial-card .author h4 {
            font-weight: 600;
            font-size: 0.95rem;
        }
        .testimonial-card .author span {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        /* CTA Banner */
        .cta-banner {
            background: var(--primary-dark);
            border-radius: var(--radius-xl);
            padding: 3rem 4rem;
            position: relative;
            overflow: hidden;
            color: #fff;
            margin: 4rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 2rem;
        }
        .cta-banner .cta-text h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        .cta-banner .cta-text p {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 1.5rem;
        }
        .cta-banner .cta-img {
            max-width: 300px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
        }
        .cta-banner .btn {
            background: #fff;
            color: var(--primary-dark);
        }
        .cta-banner .btn:hover {
            background: var(--bg-light);
        }

        /* Universities List */
        .uni-card {
            display: flex;
            background: #fff;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: var(--transition);
            margin-bottom: 1rem;
        }
        .uni-card:hover {
            box-shadow: var(--shadow-md);
        }
        .uni-card img {
            width: 220px;
            min-height: 160px;
            object-fit: cover;
            flex-shrink: 0;
        }
        .uni-card .content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 1rem;
        }
        .uni-card .content .top h3 {
            font-weight: 700;
            font-size: 1.125rem;
            margin-bottom: 0.25rem;
        }
        .uni-card .content .top span {
            font-size: 0.875rem;
            color: var(--text-muted);
            display: block;
            margin-bottom: 0.25rem;
        }
        .uni-card .content .bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .uni-card .content .bottom .rank {
            font-weight: 600;
            color: var(--accent-blue);
        }
        .uni-card .content .bottom .tuition {
            font-weight: 600;
            color: var(--text-dark);
        }
        .uni-card .content .bottom .tuition span {
            font-weight: 400;
            color: var(--text-muted);
        }

        /* Contact Form */
        .contact-form-wrapper {
            background: #fff;
            padding: 2.5rem;
            border-radius: var(--radius-xl);
            border: 1px solid var(--border-light);
            box-shadow: var(--shadow-sm);
        }
        .contact-form-wrapper h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        /* Offices */
        .office-card {
            background: #fff;
            padding: 1.5rem;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-light);
            text-align: center;
            transition: var(--transition);
        }
        .office-card:hover {
            box-shadow: var(--shadow-md);
        }
        .office-card .icon {
            color: var(--accent-blue);
            margin-bottom: 0.5rem;
        }
        .office-card h4 {
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .office-card span {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        /* Map */
        .map-container {
            border-radius: var(--radius-xl);
            overflow: hidden;
            border: 1px solid var(--border-light);
            height: 350px;
            width: 100%;
        }
        .map-container iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        /* FAQ Accordion */
        .accordion-item {
            border-bottom: 1px solid var(--border-light);
        }
        .accordion-item:last-child {
            border-bottom: 0;
        }
        .accordion-header {
            padding: 1.25rem 0;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 1rem;
            transition: var(--transition);
        }
        .accordion-header:hover {
            color: var(--accent-blue);
        }
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease, padding 0.3s ease;
            padding: 0 0;
        }
        .accordion-content p {
            color: var(--text-muted);
            padding-bottom: 1.25rem;
            font-size: 0.95rem;
        }
        .accordion-item.active .accordion-content {
            max-height: 200px;
            /* Arbitrary large height */;
        }
        .accordion-icon {
            font-size: 1.5rem;
            line-height: 1;
            transition: var(--transition);
        }
        .accordion-item.active .accordion-icon {
            transform: rotate(45deg);
        }

        /* Countries */
        .country-card {
            border-radius: var(--radius-xl);
            overflow: hidden;
            border: 1px solid var(--border-light);
            transition: var(--transition);
            background: #fff;
        }
        .country-card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-4px);
        }
        .country-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }
        .country-card .info {
            padding: 1.5rem;
            text-align: center;
        }
        .country-card .info h4 {
            font-weight: 700;
            font-size: 1.125rem;
        }

        /* Footer */
        .footer {
            background: var(--primary-dark);
            color: rgba(255, 255, 255, 0.8);
            padding: 4rem 0 2rem;
            margin-top: 4rem;
        }
        .footer h4 {
            color: #fff;
            font-weight: 600;
            margin-bottom: 1.25rem;
            font-size: 1rem;
        }
        .footer ul li {
            margin-bottom: 0.75rem;
        }
        .footer ul li a {
            font-size: 0.875rem;
        }
        .footer ul li a:hover {
            color: #fff;
        }
        .footer .social-icons {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }
        .footer .social-icons a {
            color: rgba(255, 255, 255, 0.6);
        }
        .footer .social-icons a:hover {
            color: #fff;
        }
        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 3rem;
            padding-top: 2rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.5);
        }

        /* ==========================================================================
           5. Responsive Breakpoints
           ========================================================================== */

        /* Laptop / Medium */
        @media (max-width: 1024px) {
            .grid-cols-5 {
                grid-template-columns: 1fr 1fr 1fr 1fr;
            }
            .grid-cols-4 {
                grid-template-columns: 1fr 1fr;
            }
            .grid-cols-3 {
                grid-template-columns: 1fr 1fr;
            }
            .hero-content h1 {
                font-size: 2.75rem;
            }
            .cta-banner {
                padding: 2rem 2rem;
            }
            .cta-banner .cta-text h2 {
                font-size: 2rem;
            }
            .uni-card img {
                width: 160px;
            }
        }

        /* Tablet */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
                flex-direction: column;
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                background: #fff;
                padding: 1.5rem;
                box-shadow: var(--shadow-lg);
                gap: 1rem;
                align-items: flex-start;
            }
            .nav-links.open {
                display: flex;
            }
            .hamburger {
                display: flex;
            }

            .grid-cols-2 {
                grid-template-columns: 1fr;
            }
            .grid-cols-4 {
                grid-template-columns: 1fr 1fr;
            }
            .grid-cols-5 {
                grid-template-columns: 1fr 1fr 1fr;
            }
            .grid-cols-3 {
                grid-template-columns: 1fr;
            }

            .hero-section {
                padding: 2rem 0;
            }
            .hero-content h1 {
                font-size: 2.25rem;
            }
            .hero-image {
                margin-top: 2rem;
            }
            .hero-image img {
                max-height: 300px;
                width: 100%;
                object-fit: cover;
            }

            .stat-item .number {
                font-size: 1.75rem;
            }

            .cta-banner {
                flex-direction: column;
                text-align: center;
                padding: 2rem;
            }
            .cta-banner .cta-img {
                max-width: 100%;
                margin-top: 1rem;
            }
            .cta-banner .cta-text h2 {
                font-size: 1.75rem;
            }

            .uni-card {
                flex-direction: column;
            }
            .uni-card img {
                width: 100%;
                height: 180px;
            }

            .contact-form-wrapper {
                padding: 1.5rem;
            }
            .map-container {
                height: 250px;
            }

            .footer .grid-cols-4 {
                grid-template-columns: 1fr 1fr;
            }
            .footer-bottom {
                flex-direction: column;
                text-align: center;
            }
        }

        /* Mobile */
        @media (max-width: 480px) {
            .container {
                padding: 0 1rem;
            }
            .grid-cols-5 {
                grid-template-columns: 1fr 1fr;
            }
            .grid-cols-4 {
                grid-template-columns: 1fr;
            }
            .grid-cols-2 {
                grid-template-columns: 1fr;
            }
            .grid-cols-3 {
                grid-template-columns: 1fr;
            }

            .hero-content h1 {
                font-size: 1.75rem;
            }
            .hero-content p {
                font-size: 1rem;
            }

            .cta-banner .cta-text h2 {
                font-size: 1.5rem;
            }

            .partner-logos {
                gap: 1rem;
            }
            .partner-logo {
                height: 30px;
            }

            .stat-item .number {
                font-size: 1.5rem;
            }
            .stat-item .label {
                font-size: 0.75rem;
            }

            .footer .grid-cols-4 {
                grid-template-columns: 1fr;
            }
        }

        /* Ultra-wide */
        @media (min-width: 1536px) {
            .container {
                max-width: 1400px;
            }
            .hero-content h1 {
                font-size: 4.5rem;
            }
        }
    </style>
</head>
<body>

    <!-- ==========================================================================
    NAVIGATION
    ========================================================================== -->
    <nav class="navbar">
        <div class="container flex items-center justify-between">
            <a href="#" class="logo" onclick="switchPage('home')">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                GlobalPath
            </a>
            <ul class="nav-links" id="navLinks">
                <li><a onclick="switchPage('home')" id="nav-home" class="active">Home</a></li>
                <li><a onclick="switchPage('universities')" id="nav-universities">Universities</a></li>
                <li><a onclick="switchPage('countries')" id="nav-countries">Destinations</a></li>
                <li><a onclick="switchPage('contact')" id="nav-contact">Contact</a></li>
                <li><button class="btn btn-primary btn-sm" onclick="switchPage('contact')">Book Free Consultation</button></li>
            </ul>
            <div class="hamburger" id="hamburger" onclick="toggleMobileMenu()">
                <span></span><span></span><span></span>
            </div>
        </div>
    </nav>

    <!-- ==========================================================================
    MAIN CONTENT (SPA Pages)
    ========================================================================== -->
    <main>

        <!-- ==========================================
        PAGE: HOME
        ========================================== -->
        <section id="page-home" class="page-section active">

            <!-- Hero -->
            <div class="container hero-section">
                <div class="grid grid-cols-2 gap-12 items-center">
                    <div class="hero-content">
                        <h1>Study Abroad.<br />Build a Global Future.</h1>
                        <p>Personalized guidance for your global education journey. Expert support for admissions, visas, and scholarships.</p>
                        <div class="flex gap-4 flex-wrap">
                            <button class="btn btn-primary btn-lg" onclick="switchPage('contact')">Book Free Consultation</button>
                            <button class="btn btn-outline btn-lg">Read More</button>
                        </div>
                    </div>
                    <div class="hero-image">
                        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80" alt="Students studying abroad" loading="lazy" />
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="stats-container">
                <div class="container">
                    <div class="grid grid-cols-4 gap-4">
                        <div class="stat-item">
                            <div class="icon"><svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
                            <div class="number"><span data-count="10">0</span>+</div>
                            <div class="label">Years of Excellence</div>
                        </div>
                        <div class="stat-item">
                            <div class="icon"><svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></div>
                            <div class="number"><span data-count="25000">0</span>+</div>
                            <div class="label">Students Placed</div>
                        </div>
                        <div class="stat-item">
                            <div class="icon"><svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
                            <div class="number"><span data-count="500">0</span>+</div>
                            <div class="label">Partner Universities</div>
                        </div>
                        <div class="stat-item">
                            <div class="icon"><svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
                            <div class="number"><span data-count="95">0</span>%</div>
                            <div class="label">Visa Success Rate</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Universities -->
            <div class="container py-12">
                <div class="section-header text-center mb-8">
                    <h2>Top Universities We Work With</h2>
                    <p>Exclusive partnerships with world-class institutions across the globe.</p>
                </div>
                <div class="partner-logos">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/56/MIT_logo.svg/512px-MIT_logo.svg.png" alt="MIT" class="partner-logo" loading="lazy" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/01/Stanford_University_logo.svg/512px-Stanford_University_logo.svg.png" alt="Stanford" class="partner-logo" loading="lazy" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/83/UC_Berkeley_Logo.svg/512px-UC_Berkeley_Logo.svg.png" alt="UC Berkeley" class="partner-logo" loading="lazy" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/University_of_Melbourne_Logo.svg/512px-University_of_Melbourne_Logo.svg.png" alt="Melbourne" class="partner-logo" loading="lazy" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/NUS_logo.svg/512px-NUS_logo.svg.png" alt="NUS" class="partner-logo" loading="lazy" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/University_of_Sydney_logo.svg/512px-University_of_Sydney_logo.svg.png" alt="Sydney" class="partner-logo" loading="lazy" />
                </div>
            </div>

            <!-- Services -->
            <div class="container py-12">
                <div class="section-header text-center mb-8">
                    <h2>Our Services</h2>
                    <p>Comprehensive support tailored to your study abroad ambitions.</p>
                </div>
                <div class="grid grid-cols-5 gap-6">
                    <div class="service-card">
                        <div class="icon-wrapper"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM8 17.5l-4-4 1.41-1.41L8 14.67l9.59-9.59L19 6.5 8 17.5z"/></svg></div>
                        <h3>University Shortlisting</h3>
                        <p>Expert guidance to match your profile with the best universities.</p>
                    </div>
                    <div class="service-card">
                        <div class="icon-wrapper"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg></div>
                        <h3>Application Support</h3>
                        <p>End-to-end assistance with applications, essays, and LORs.</p>
                    </div>
                    <div class="service-card">
                        <div class="icon-wrapper"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg></div>
                        <h3>Visa Assistance</h3>
                        <p>Streamlined visa processing with a 95% success rate.</p>
                    </div>
                    <div class="service-card">
                        <div class="icon-wrapper"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
                        <h3>Scholarship Guidance</h3>
                        <p>Access to scholarships and financial aid opportunities.</p>
                    </div>
                    <div class="service-card">
                        <div class="icon-wrapper"><svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></div>
                        <h3>Pre-Departure Support</h3>
                        <p>Cultural training and guidance for a smooth transition.</p>
                    </div>
                </div>
            </div>

            <!-- Journey -->
            <div class="container py-12">
                <div class="section-header text-center mb-8">
                    <h2>Your Journey, Simplified</h2>
                    <p>A step-by-step roadmap to your dream university.</p>
                </div>
                <div class="grid grid-cols-4 gap-4">
                    <div class="journey-step">
                        <div class="step-number">1</div>
                        <h4>Research</h4>
                        <p>Explore global universities and programs that match your goals.</p>
                    </div>
                    <div class="journey-step">
                        <div class="step-number">2</div>
                        <h4>Apply</h4>
                        <p>We guide you through applications, deadlines, and documentation.</p>
                    </div>
                    <div class="journey-step">
                        <div class="step-number">3</div>
                        <h4>Secure Visa</h4>
                        <p>Expert support for your student visa interview and process.</p>
                    </div>
                    <div class="journey-step">
                        <div class="step-number">4</div>
                        <h4>Depart</h4>
                        <p>Arrive prepared with our pre-departure briefings.</p>
                    </div>
                </div>
            </div>

            <!-- Testimonials -->
            <div class="container py-12">
                <div class="section-header text-center mb-8">
                    <h2>What Students Say</h2>
                    <p>Real stories from students who transformed their futures.</p>
                </div>
                <div class="grid grid-cols-3 gap-6">
                    <div class="testimonial-card">
                        <div class="stars">★★★★★</div>
                        <p class="quote">"GlobalPath made my dream of studying in the US a reality. Their support with the application process was phenomenal!"</p>
                        <div class="author">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80" alt="Ethan" loading="lazy" />
                            <div>
                                <h4>Ethan Mitchell</h4>
                                <span>University of Texas, USA</span>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-card">
                        <div class="stars">★★★★★</div>
                        <p class="quote">"The visa assistance team was incredible. They prepared me perfectly for my interview, and I got my visa in 5 days!"</p>
                        <div class="author">
                            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80" alt="Priya" loading="lazy" />
                            <div>
                                <h4>Priya Sharma</h4>
                                <span>University of Sydney, Australia</span>
                            </div>
                        </div>
                    </div>
                    <div class="testimonial-card">
                        <div class="stars">★★★★★</div>
                        <p class="quote">"They helped me secure a scholarship that covered 70% of my tuition. I couldn't have done it without them."</p>
                        <div class="author">
                            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=100&q=80" alt="Liam" loading="lazy" />
                            <div>
                                <h4>Liam O'Brien</h4>
                                <span>University of Melbourne, Australia</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Banner -->
            <div class="container">
                <div class="cta-banner">
                    <div class="cta-text">
                        <h2>Ready to Start Your Journey?</h2>
                        <p>Book a free consultation with our expert counselors today.</p>
                        <button class="btn btn-lg" onclick="switchPage('contact')">Book Free Consultation</button>
                    </div>
                    <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=600&q=80" alt="Students" class="cta-img" loading="lazy" />
                </div>
            </div>

        </section>

        <!-- ==========================================
        PAGE: UNIVERSITIES
        ========================================== -->
        <section id="page-universities" class="page-section">
            <div class="container py-12">
                <h1 class="text-4xl font-bold mb-8">Find Your Dream University</h1>

                <!-- Filters -->
                <div class="flex flex-wrap items-center gap-4 mb-8 bg-light p-4 rounded-lg border border-light">
                    <input type="text" class="form-input" placeholder="Search by university name..." style="flex: 1; min-width: 150px;" />
                    <select class="form-input" style="width: auto; min-width: 120px;">
                        <option>Country</option>
                        <option>USA</option>
                        <option>UK</option>
                        <option>Canada</option>
                    </select>
                    <select class="form-input" style="width: auto; min-width: 120px;">
                        <option>QS Ranking</option>
                        <option>Top 50</option>
                        <option>Top 100</option>
                    </select>
                    <select class="form-input" style="width: auto; min-width: 120px;">
                        <option>Tuition Range</option>
                        <option>$0 - $20k</option>
                        <option>$20k - $40k</option>
                    </select>
                    <select class="form-input" style="width: auto; min-width: 120px;">
                        <option>More Filters</option>
                    </select>
                    <a href="#" class="text-sm font-medium text-blue hover:underline ml-auto">Clear All</a>
                </div>

                <!-- University List -->
                <div class="flex flex-col gap-4">
                    <div class="uni-card">
                        <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=400&q=80" alt="MIT" loading="lazy" />
                        <div class="content">
                            <div class="top">
                                <h3>Massachusetts Institute of Technology</h3>
                                <span>Cambridge, USA</span>
                            </div>
                            <div class="bottom">
                                <span class="rank">#1 QS World University Rankings</span>
                                <span class="tuition">$61,800 <span>/year</span></span>
                                <button class="btn btn-primary btn-sm">Apply Now</button>
                            </div>
                        </div>
                    </div>
                    <div class="uni-card">
                        <img src="https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&w=400&q=80" alt="Stanford" loading="lazy" />
                        <div class="content">
                            <div class="top">
                                <h3>Stanford University</h3>
                                <span>Stanford, USA</span>
                            </div>
                            <div class="bottom">
                                <span class="rank">#3 QS World University Rankings</span>
                                <span class="tuition">$58,484 <span>/year</span></span>
                                <button class="btn btn-primary btn-sm">Apply Now</button>
                            </div>
                        </div>
                    </div>
                    <div class="uni-card">
                        <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=400&q=80" alt="Oxford" loading="lazy" />
                        <div class="content">
                            <div class="top">
                                <h3>University of Oxford</h3>
                                <span>Oxford, UK</span>
                            </div>
                            <div class="bottom">
                                <span class="rank">#4 QS World University Rankings</span>
                                <span class="tuition">$41,000 <span>/year</span></span>
                                <button class="btn btn-primary btn-sm">Apply Now</button>
                            </div>
                        </div>
                    </div>
                    <div class="uni-card">
                        <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=400&q=80" alt="Melbourne" loading="lazy" />
                        <div class="content">
                            <div class="top">
                                <h3>The University of Melbourne</h3>
                                <span>Melbourne, Australia</span>
                            </div>
                            <div class="bottom">
                                <span class="rank">#14 QS World University Rankings</span>
                                <span class="tuition">$38,400 <span>/year</span></span>
                                <button class="btn btn-primary btn-sm">Apply Now</button>
                            </div>
                        </div>
                    </div>
                    <div class="uni-card">
                        <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=400&q=80" alt="NUS" loading="lazy" />
                        <div class="content">
                            <div class="top">
                                <h3>National University of Singapore</h3>
                                <span>Singapore</span>
                            </div>
                            <div class="bottom">
                                <span class="rank">#8 QS World University Rankings</span>
                                <span class="tuition">$31,600 <span>/year</span></span>
                                <button class="btn btn-primary btn-sm">Apply Now</button>
                            </div>
                        </div>
